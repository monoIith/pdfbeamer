<Window
    x:Class="PdfEditor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PDF Textbox Editor">

    <Grid x:Name="RootGrid" Loaded="OnLoaded" KeyDown="OnKeyDown" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="Open" Click="OnOpen" />
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="OnSave" IsEnabled="False" />
            <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Label="Save As" Click="OnSaveAs" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="OnUndo" IsEnabled="False" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="OnRedo" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarToggleButton x:Name="PagesButton" Icon="ViewAll" Label="Pages"
                                Click="OnToggleThumbnails" IsChecked="True" />
            <AppBarToggleButton x:Name="SelectToolButton" Icon="TouchPointer" Label="Select" Click="OnSelectTool" IsChecked="True" />
            <AppBarToggleButton x:Name="TextToolButton" Icon="Font" Label="Text" Click="OnTextTool" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" />
                    <ComboBox x:Name="ZoomCombo" Width="112" SelectionChanged="OnZoomChanged">
                        <ComboBoxItem Content="Fit Width" IsSelected="True" />
                        <ComboBoxItem Content="Fit Page" />
                        <ComboBoxItem Content="50%" Tag="50" />
                        <ComboBoxItem Content="75%" Tag="75" />
                        <ComboBoxItem Content="100%" Tag="100" />
                        <ComboBoxItem Content="125%" Tag="125" />
                        <ComboBoxItem Content="150%" Tag="150" />
                        <ComboBoxItem Content="200%" Tag="200" />
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FormatBar" Orientation="Horizontal" Spacing="8" Padding="12,6"
                        IsEnabled="False" VerticalAlignment="Center">
                <TextBlock Text="Text" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FontCombo" Width="148" SelectionChanged="OnSelectionFormattingChanged">
                    <ComboBoxItem Content="Noto Sans" IsSelected="True" />
                    <ComboBoxItem Content="Noto Serif" />
                    <ComboBoxItem Content="Noto Sans Mono" />
                </ComboBox>
                <NumberBox x:Name="FontSizeBox" Width="82" Minimum="6" Maximum="144" Value="12"
                           SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberFormattingChanged" />
                <ToggleButton x:Name="BoldButton" Content="B" FontWeight="Bold" Width="36"
                              Checked="OnToggleFormattingChanged" Unchecked="OnToggleFormattingChanged" />
                <ToggleButton x:Name="ItalicButton" Content="I" FontStyle="Italic" Width="36"
                              Checked="OnToggleFormattingChanged" Unchecked="OnToggleFormattingChanged" />
                <ComboBox x:Name="AlignmentCombo" Width="92" SelectionChanged="OnSelectionFormattingChanged">
                    <ComboBoxItem Content="Left" IsSelected="True" />
                    <ComboBoxItem Content="Center" />
                    <ComboBoxItem Content="Right" />
                </ComboBox>
                <TextBlock Text="Text color" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="TextColorCombo" Width="92" SelectionChanged="OnSelectionFormattingChanged" />
                <TextBlock Text="Border" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="BorderColorCombo" Width="92" SelectionChanged="OnSelectionFormattingChanged" />
                <NumberBox x:Name="BorderWidthBox" Width="72" Minimum="0" Maximum="8" Value="1"
                           SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberFormattingChanged" />
                <TextBlock Text="Fill" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox x:Name="FillColorCombo" Width="92" SelectionChanged="OnSelectionFormattingChanged" />
                <TextBlock Text="Opacity" VerticalAlignment="Center" />
                <NumberBox x:Name="FillOpacityBox" Width="78" Minimum="0" Maximum="100" Value="0"
                           SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="OnNumberFormattingChanged" />
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="8,0,8,6" />

        <Grid Grid.Row="3" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ThumbnailColumn" Width="176" />
                <ColumnDefinition x:Name="ThumbnailDividerColumn" Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ThumbnailRail" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8">
                    <TextBlock Text="Pages" FontWeight="SemiBold" />
                </Grid>
                <ListView x:Name="ThumbnailList" Grid.Row="1" SelectionChanged="OnThumbnailSelected"
                          HorizontalContentAlignment="Stretch" />
            </Grid>

            <Border x:Name="ThumbnailDivider" Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="DocumentScroll" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                              ViewChanged="OnDocumentViewChanged"
                              PointerWheelChanged="OnDocumentPointerWheelChanged">
                    <StackPanel x:Name="PagesPanel" Padding="32" Spacing="24" HorizontalAlignment="Center" />
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8A5;" FontSize="54" Opacity="0.55" HorizontalAlignment="Center" />
                    <TextBlock Text="Open a PDF to begin" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Add textboxes, format them, and save a new permanent PDF."
                               Opacity="0.7" HorizontalAlignment="Center" />
                    <Button Content="Open PDF" Click="OnOpen" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Padding="12,5" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" />
            <TextBlock x:Name="PageStatusText" Grid.Column="1" Text="No document" />
        </Grid>
    </Grid>
</Window>
